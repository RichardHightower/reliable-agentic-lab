# Every value here is optional. The labs run with none of them set.
# Never commit this file with real values filled in.

# --- Model providers. Only needed to drive a loop with a real agent. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Research, Module 3. Without a key, use --backend websearch or fixture. ---
PERPLEXITY_API_KEY=

# --- GitHub, Module 4 only. Contents, Issues, Pull requests. ---
GITHUB_TOKEN=
GITHUB_REPO=RichardHightower/northwind-field-crm

# --- Observability, take-home only. Local JSON traces are the fallback. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Extra credit 1 and 5. Webhook receiver on a Droplet. ---
# Copy labs/extra-credit/ext_5_digitalocean/.env.example to /opt/agents/.env
# on the box. These names match that file.
GITHUB_WEBHOOK_SECRET=
AGENT_BACKEND=claude
AGENT_MAX_ATTEMPTS=3
AGENT_TIMEOUT=900
CRM_OWNER=
CRM_REPO=northwind-field-crm
WEBHOOK_DOMAIN=
XAI_API_KEY=
