# Copy to .env and fill. Never commit .env.

# GitHub. Fine-grained token: Contents, Issues, Pull requests on this repo.
# Classic token: repo scope.
GITHUB_TOKEN=
GITHUB_REPO=RichardHightower/reliable-agentic-lab

# Model keys. Fill the provider you actually use. Graders run without these.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional
PERPLEXITY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
