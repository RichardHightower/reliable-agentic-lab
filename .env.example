# Every value here is optional. The labs run with none of them set.
# Never commit this file with real values filled in.

# --- Model providers. Only needed to drive a loop with a real agent. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Research, Module 3. Without a key, use --backend websearch or fixture. ---
PERPLEXITY_API_KEY=

# --- GitHub, Module 4 only. Contents, Issues, Pull requests. ---
GITHUB_TOKEN=
GITHUB_REPO=RichardHightower/northwind-field-crm

# --- Observability, take-home only. Local JSON traces are the fallback. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
