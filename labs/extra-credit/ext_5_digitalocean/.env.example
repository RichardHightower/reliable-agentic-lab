# Copy to /opt/agents/.env on the Droplet. Never commit the copy.
#   cp labs/extra-credit/ext_5_digitalocean/.env.example /opt/agents/.env

# GitHub token that can label and comment on the CRM fork.
GITHUB_TOKEN=

# CRM fork that holds tickets/ and the issues this webhook receives.
# Not the lab repo. sol1_enhancer talks to this repo via gh.
GITHUB_REPO=your-github-username/northwind-field-crm

# Same value you paste into the GitHub webhook secret field.
GITHUB_WEBHOOK_SECRET=

# claude -> solutions/sol1_enhancer (Claude Code plugin, the default)
# grok -> solutions/sol1_enhancer_grok_build
# opencode -> solutions/sol1_enhancer_opencode
# codex -> solutions/sol1_enhancer_codex
# agent-sdk -> solutions/sol1_enhancer_agent_sdk
# deep-agents / langgraph -> solutions/sol1_enhancer_deep_agents
AGENT_BACKEND=claude
AGENT_MAX_ATTEMPTS=3
AGENT_TIMEOUT=900

# Written by bootstrap.sh from GITHUB_REPO. Used to fill sol1 config.json.
CRM_OWNER=your-github-username
CRM_REPO=northwind-field-crm

# Bind. systemd keeps this on loopback. nginx is the only public door.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000

LOCK_DIR=/opt/agents/solutions/extra_credit/s_ext_1_webhook/work/locks
WEBHOOK_JOURNAL=/opt/agents/solutions/extra_credit/s_ext_1_webhook/work/last-webhook.json

# Needed when AGENT_BACKEND=claude (sol1_enhancer).
ANTHROPIC_API_KEY=

# Optional ports of the same lab.
OPENAI_API_KEY=
XAI_API_KEY=

# Public hostname you pointed at the Droplet.
WEBHOOK_DOMAIN=agents.example.com
