# Every value here is optional. `task test`, `task table`, `task checks`, and
# `task paper` on the fixture backend run with none of them set.
#
# The repo root `.env` is the normal place for these. Copy this file to `.env`
# here only when you want a value that differs from the root.

# --- The model that drives the loop. Needed by `task live`. ---
ANTHROPIC_API_KEY=

# --- Research. Without it, the loop falls back to the recorded fixture. ---
# The MCP server in ../../.mcp.json reads this same name.
PERPLEXITY_API_KEY=

# --- Diagram polish. Without it, figures ship as SVG and the sidecar says
# --- polished: false. The pipeline still finishes.
GEMINI_API_KEY=

# --- Prior research. Defaults to ../../../loop_eng_2nd_brain/knowledge.
# --- Absent is fine. The planner says so and continues.
SECOND_BRAIN=

# --- Perplexity model, if you want something other than sonar-pro.
PERPLEXITY_MODEL=
