# Copy onto the Droplet as /etc/systemd/system/agent-webhook.service
#   systemctl daemon-reload && systemctl enable --now agent-webhook
#
# Binds 127.0.0.1:8000. nginx is the only public door.
# Calls solutions/extra_credit/s_ext_1_webhook, which shells out to
# solutions/sol1_enhancer.

[Unit]
Description=reliable-agentic-lab extra-credit GitHub webhook
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/agents
Environment=PYTHONPATH=/opt/agents
Environment=PATH=/opt/agent-env/bin:/usr/local/bin:/usr/bin
EnvironmentFile=/opt/agents/.env
ExecStart=/opt/agent-env/bin/python -m uvicorn solutions.extra_credit.s_ext_1_webhook.webhook:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/agents
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
