flowchart TD
    Start([One poll]) --> Open["open_tickets"]
    Open --> Choose{"Ticket available?"}
    Choose -- No --> End([Return])
    Choose -- Yes --> Inspect["Agent SDK judge turn"]
    Inspect --> Fields["check_fields"]
    Fields --> Ready{"Ready?"}
    Ready -- Yes --> LGTM{"Human LGTM?"}
    LGTM -- Yes --> Publish["Python updates issue and labels"]
    LGTM -- No --> Wait["waiting for LGTM"]
    Ready -- No --> Candidate["Agent SDK doer turn"]
    Candidate --> Persist["Store candidate"]
    Persist --> Gate["check_stop"]
    Gate --> Decision{"Stop?"}
    Decision -- No --> Wait2["waiting, still missing fields"]
    Decision -- Yes --> Escalate["Mark needs-human"]
    Publish --> End
    Wait --> End
    Wait2 --> End
    Escalate --> End
