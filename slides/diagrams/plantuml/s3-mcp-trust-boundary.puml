@startuml s3-mcp-trust-boundary
skinparam backgroundColor #07141f
skinparam defaultFontColor #eef4f6
skinparam ArrowColor #2dd4bf
skinparam BorderColor #2dd4bf
skinparam titleFontColor #d4a84b
skinparam shadowing false
skinparam packageBackgroundColor #0d1e2c
skinparam packageBorderColor #2dd4bf
skinparam rectangleBackgroundColor #0d1e2c
skinparam rectangleBorderColor #2dd4bf
skinparam noteBackgroundColor #122536
skinparam noteBorderColor #d4a84b
skinparam noteFontColor #eef4f6
title MCP trust boundary
package "Untrusted" {
  rectangle "Tool output\n(a document the internet wrote)" as Out
  rectangle "Model proposal" as Model
}
package "Trusted process" {
  rectangle "search(question)\none function" as Search
  rectangle "Budget.charge()" as Budget
  rectangle "check_brief()\narithmetic" as Check
  rectangle "WriteScope\nbriefs/ only" as Scope
}
package "Denied" {
  rectangle "merge" as Merge
  rectangle "deploy" as Deploy
  rectangle "ticket state" as Ticket
  rectangle "production" as Prod
}
Model --> Search
Search --> Out
Out --> Check
Check --> Budget
Model --> Scope
note right of Merge
  The loop cannot merge.
  A missing tool, not a prompt.
end note
@enduml
